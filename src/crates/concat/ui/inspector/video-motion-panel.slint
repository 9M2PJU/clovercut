import { I18n } from "../i18n.slint";
import { Section, SectionHeader, SectionBody, Row } from "../primitives/panel.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Theme } from "../theme/theme.slint";
import { Note, ValueControl } from "controls.slint";

export global VideoMotion {
    in property <int> entrance;
    in property <int> exit;
    in property <float> duration;
    callback set(entrance: int, exit: int, duration: float);
}
export component VideoMotionPanel inherits VerticalLayout {
    property <float> duration: VideoMotion.duration;
    property <float> shown-duration: VideoMotion.duration;
    changed shown-duration => { root.duration = root.shown-duration; }
    Section {
        first: true;
        SectionHeader { title: I18n.t("videoMotion.animation"); }
        Note { text: I18n.t("videoMotion.hint"); }
    }
    Section {
        SectionHeader { title: I18n.t("captions.entrance"); }
        SectionBody {
            padding-left: Theme.pad; padding-right: Theme.pad;
            SegmentedControl {
                options: [I18n.t("common.none"), I18n.t("captions.fade"), I18n.t("captions.slide"), I18n.t("captions.pop")];
                property <int> shown: VideoMotion.entrance;
                current: self.shown;
                changed shown => { self.current = self.shown; }
                changed(index) => { VideoMotion.set(index, VideoMotion.exit, VideoMotion.duration); }
            }
        }
    }
    Section {
        SectionHeader { title: I18n.t("captions.exit"); }
        SectionBody {
            padding-left: Theme.pad; padding-right: Theme.pad;
            SegmentedControl {
                options: [I18n.t("common.none"), I18n.t("captions.fade"), I18n.t("captions.slide"), I18n.t("captions.pop")];
                property <int> shown: VideoMotion.exit;
                current: self.shown;
                changed shown => { self.current = self.shown; }
                changed(index) => { VideoMotion.set(VideoMotion.entrance, index, VideoMotion.duration); }
            }
        }
        Row {
            label: I18n.t("captions.effectDuration");
            ValueControl {
                value <=> root.duration; minimum: 0.05; maximum: 5; step: 0.05; unit: "s";
                changed(value) => { VideoMotion.set(VideoMotion.entrance, VideoMotion.exit, value); }
            }
        }
    }
}
