import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Row, Section, SectionHeader, SectionBody } from "../primitives/panel.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Check, ValueControl } from "controls.slint";
import { CaptionsLibrary } from "../workspace/captions-panel.slint";

export component MotionPresetCard inherits Rectangle {
    in property <string> label;
    in property <Glyph> glyph;
    in property <bool> active: false;
    callback clicked();

    height: 56px;
    horizontal-stretch: 1;
    border-radius: Theme.r;
    background: area.has-hover ? Theme.field-hover : Theme.well;
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? Theme.accent : Theme.line;

    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Icon {
                glyph: root.glyph;
                size: 16px;
                tint: root.active ? Theme.accent : Theme.fg-muted;
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.fg : Theme.fg-muted;
            font-size: Theme.fs-xs;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component CaptionMotionPanel inherits VerticalLayout {
    property <float> duration;
    property <float> shown-duration: CaptionsLibrary.duration;
    init => { root.duration = root.shown-duration; }
    changed shown-duration => { root.duration = root.shown-duration; }
    if CaptionsLibrary.style-count > 0: Section {
        SectionBody {
            padding-left: Theme.pad; padding-right: Theme.pad;
            HorizontalLayout {
                spacing: 8px;
                Check { checked: CaptionsLibrary.apply-all; toggled(on) => { CaptionsLibrary.scope-changed(on); } }
                Text { text: I18n.t("captions.applyAll"); color: Theme.fg; font-size: Theme.fs; }
            }
        }
    }
    Section {
        first: CaptionsLibrary.style-count == 0;
        SectionHeader { title: I18n.t("captions.entrance"); }
        SectionBody {
            padding-left: Theme.pad; padding-right: Theme.pad;
            spacing: 6px;
            HorizontalLayout {
                spacing: 6px;
                MotionPresetCard {
                    label: I18n.t("common.none"); glyph: Glyph.close;
                    active: CaptionsLibrary.entrance == 0;
                    clicked => { CaptionsLibrary.motion(0, CaptionsLibrary.exit, CaptionsLibrary.duration); }
                }
                MotionPresetCard {
                    label: I18n.t("captions.fade"); glyph: Glyph.sun;
                    active: CaptionsLibrary.entrance == 1;
                    clicked => { CaptionsLibrary.motion(1, CaptionsLibrary.exit, CaptionsLibrary.duration); }
                }
                MotionPresetCard {
                    label: I18n.t("captions.slide"); glyph: Glyph.chevron-right;
                    active: CaptionsLibrary.entrance == 2;
                    clicked => { CaptionsLibrary.motion(2, CaptionsLibrary.exit, CaptionsLibrary.duration); }
                }
                MotionPresetCard {
                    label: I18n.t("captions.pop"); glyph: Glyph.sparkle;
                    active: CaptionsLibrary.entrance == 3;
                    clicked => { CaptionsLibrary.motion(3, CaptionsLibrary.exit, CaptionsLibrary.duration); }
                }
            }
            SegmentedControl {
                options: [I18n.t("common.none"), I18n.t("captions.fade"), I18n.t("captions.slide"), I18n.t("captions.pop")];
                property <int> shown: CaptionsLibrary.entrance;
                current: self.shown;
                changed shown => { self.current = self.shown; }
                changed(i) => { CaptionsLibrary.motion(i, CaptionsLibrary.exit, CaptionsLibrary.duration); }
            }
        }
    }
    Section {
        SectionHeader { title: I18n.t("captions.exit"); }
        SectionBody {
            padding-left: Theme.pad; padding-right: Theme.pad;
            spacing: 6px;
            HorizontalLayout {
                spacing: 6px;
                MotionPresetCard {
                    label: I18n.t("common.none"); glyph: Glyph.close;
                    active: CaptionsLibrary.exit == 0;
                    clicked => { CaptionsLibrary.motion(CaptionsLibrary.entrance, 0, CaptionsLibrary.duration); }
                }
                MotionPresetCard {
                    label: I18n.t("captions.fade"); glyph: Glyph.sun;
                    active: CaptionsLibrary.exit == 1;
                    clicked => { CaptionsLibrary.motion(CaptionsLibrary.entrance, 1, CaptionsLibrary.duration); }
                }
                MotionPresetCard {
                    label: I18n.t("captions.slide"); glyph: Glyph.chevron-right;
                    active: CaptionsLibrary.exit == 2;
                    clicked => { CaptionsLibrary.motion(CaptionsLibrary.entrance, 2, CaptionsLibrary.duration); }
                }
                MotionPresetCard {
                    label: I18n.t("captions.pop"); glyph: Glyph.sparkle;
                    active: CaptionsLibrary.exit == 3;
                    clicked => { CaptionsLibrary.motion(CaptionsLibrary.entrance, 3, CaptionsLibrary.duration); }
                }
            }
            SegmentedControl {
                options: [I18n.t("common.none"), I18n.t("captions.fade"), I18n.t("captions.slide"), I18n.t("captions.pop")];
                property <int> shown: CaptionsLibrary.exit;
                current: self.shown;
                changed shown => { self.current = self.shown; }
                changed(i) => { CaptionsLibrary.motion(CaptionsLibrary.entrance, i, CaptionsLibrary.duration); }
            }
        }
        Row {
            label: I18n.t("captions.effectDuration");
            ValueControl {
                value <=> root.duration; minimum: 0.05; maximum: 5; step: 0.05; unit: "s";
                changed(v) => { CaptionsLibrary.motion(CaptionsLibrary.entrance, CaptionsLibrary.exit, v); }
            }
        }
    }
}
